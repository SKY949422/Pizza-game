    end)
end

local function loadUserConfig()
    if isfile and isfile(CONFIG_FILE_PATH) then
        local ok, content = pcall(function() return readfile(CONFIG_FILE_PATH) end)
        if ok and content then
            local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeOk and typeof(data) == "table" then
