local function findNearestTower(targetPos, maxDist)
    local bestTower = nil
    local minDistance = maxDist or 12
    local towersFolder = workspace:FindFirstChild("Towers")

    if towersFolder and targetPos then
        for _, child in ipairs(towersFolder:GetChildren()) do
            local pos = safeGetPosition(child) or towerPositionCache[child]
            if pos then
                local dist = (pos - targetPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    bestTower = child
                end
            end
        end
    end
    return bestTower
end

local function getMatchCash()
    local cash = 0
    pcall(function()
        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            local c = ls:FindFirstChild("Cash") or ls:FindFirstChild("Money")
            if c and typeof(c.Value) == "number" then cash = c.Value end
        end
        if cash == 0 then
            local pgui = LocalPlayer:FindFirstChild("PlayerGui")
            if pgui then
                for _, lbl in ipairs(pgui:GetDescendants()) do
                    if lbl:IsA("TextLabel") and lbl.Visible and lbl.Text then
                        local m = lbl.Text:match("^%s*(%d+[,%d]*)%s*$")
                        if m then
                            local num = tonumber((m:gsub(",", "")))
                            if num and num > cash and num < 10000000 then cash = num end
                        end
                    end
                end
            end
        end
    end)
    return cash
end

local function getTowerLevel(target)
    if not target then return 0 end
    local lv = 0
    pcall(function()
        for _, attr in ipairs({"Level", "Upgrade", "Tier", "Lv"}) do
            local val = target:GetAttribute(attr)
            if typeof(val) == "number" then lv = val break end
        end
        if lv == 0 then
            for _, name in ipairs({"Level", "Upgrade", "Tier", "Lv"}) do
                local valObj = target:FindFirstChild(name)
                if valObj and typeof(valObj.Value) == "number" then lv = valObj.Value break end
            end
        end
    end)
    return lv
end

local function isTowerMax(target)
    if not target then return false end
    local isMax = false
    pcall(function()
        if target:GetAttribute("Max") == true or target:GetAttribute("IsMax") == true then isMax = true end
        if target:FindFirstChild("Max") or target:FindFirstChild("IsMax") then isMax = true end
        local lv = getTowerLevel(target)
        if lv >= 4 then isMax = true end
    end)
    return isMax
end

