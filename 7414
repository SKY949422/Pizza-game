task.spawn(function()
    local lastCount = -1
    local lastState = false
    while _G.Suite7414_NewGame_Running do
        task.wait(0.2)
        if #recordedActions ~= lastCount or isRecording ~= lastState then
            lastCount = #recordedActions
            lastState = isRecording
            pcall(function()
                if recordCtrl then
