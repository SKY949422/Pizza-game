-- 8. 巨集重播核心 (真實扣款驗證 + 滿級無感跳過 + 告別紅字)
-- --------------------------------------------------------
runPlayMacro = function(st)
    if isRecording then return end

    if st then
        if #recordedActions == 0 then
            warn("[ATD 提示] 目前檔案無動作記錄，請先開啟錄製。")
            return
        end

        task.spawn(function()
            isPlaying = true
            print(string.format("[ATD 重播啟動] 執行「%s」，共 %d 步 (智慧金幣/滿級感知模式)", currentMacroName, #recordedActions))

            for i, step in ipairs(recordedActions) do
                if not isPlaying or not _G.Suite7414_NewGame_Running or not UserConfig.playMacro then break end
                
                local stepTitle = (step.type == "Place" and "放塔") or (step.type == "Upgrade" and "升級") or "賣塔"
                print(string.format("[ATD 執行] (%d/%d) %s: %s", i, #recordedActions, stepTitle, tostring(step.towerName)))
                if playCtrl then
                    playCtrl.SetDesc(string.format("▶ (%d/%d) %s: %s...", i, #recordedActions, stepTitle, tostring(step.towerName)))
                end

                task.wait(0.12)

                if not isPlaying or not _G.Suite7414_NewGame_Running or not UserConfig.playMacro then break end

                -- 1. 放塔
                if step.type == "Place" then
                    local rTarget = (ReplicatedStorage:FindFirstChild("RemoteFunctions") and ReplicatedStorage.RemoteFunctions:FindFirstChild(step.remoteName or "PlaceTower"))
                        or (ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild(step.remoteName or "PlaceTower"))

                    if rTarget then
                        local startTime = os.clock()
                        local lastNotifyTime = 0

                        while isPlaying and _G.Suite7414_NewGame_Running and UserConfig.playMacro do
                            if checkGameResult() then break end

                            local currentTowers = workspace:FindFirstChild("Towers")
                            local currentCount = currentTowers and #currentTowers:GetChildren() or 0

                            if currentCount >= 10 then
                                print(string.format("[ATD 提示] (%d/%d) 塔位已滿 10/10，跳過此放塔", i, #recordedActions))
                                break
                            end

                            local beforeTowers = {}
                            if currentTowers then
                                for _, t in ipairs(currentTowers:GetChildren()) do beforeTowers[t] = true end
                            end

                            local called, res = safeInvokeServer(rTarget, 1.5, step.towerName, step.cframe)
                            task.wait(0.15)

                            local newlyCreated = false
                            if currentTowers then
                                for _, t in ipairs(currentTowers:GetChildren()) do
                                    if not beforeTowers[t] then
                                        newlyCreated = true
                                        local p = safeGetPosition(t)
                                        if p then towerPositionCache[t] = p end
                                        break
                                    end
                                end
                            end

                            if newlyCreated or (res == true) then
                                print(string.format("[ATD 放塔成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                task.wait(0.2)
                                break
                            end

                            -- 溫和等錢 (每 3 秒日誌提示，杜絕發包過載)
                            if os.clock() - lastNotifyTime >= 3.0 then
                                lastNotifyTime = os.clock()
                                local curCash = getMatchCash()
                                print(string.format("[ATD 放塔等待] (%d/%d) 等待金幣放塔 %s (金幣: %d, 已等待 %.0fs)", 
                                    i, #recordedActions, tostring(step.towerName), curCash, os.clock() - startTime))
                            end

                            if os.clock() - startTime > 15.0 then
                                print(string.format("[ATD 超時] (%d/%d) 放塔超時，自動前進下一步！", i, #recordedActions))
                                break
                            end

                            task.wait(0.5)
                        end
                    end

                -- 2. 升級塔 (★ 真實扣款判定 + 滿級無感跳過)
                elseif step.type == "Upgrade" then
                    local upgradeFunc = (ReplicatedStorage:FindFirstChild("RemoteFunctions") and ReplicatedStorage.RemoteFunctions:FindFirstChild("UpgradeTower"))
                        or (ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("UpgradeTower"))

                    if upgradeFunc and step.position then
                        local startTime = os.clock()
                        local lastNotifyTime = 0
                        local failedAttempts = 0

                        while isPlaying and _G.Suite7414_NewGame_Running and UserConfig.playMacro do
                            if checkGameResult() then break end

                            local target = findNearestTower(step.position, 12)
                            if not target then
                                if os.clock() - startTime > 2.0 then
                                    print(string.format("[ATD 提示] (%d/%d) 找不到目標塔，跳過此升級", i, #recordedActions))
                                    break
                                end
                            else
                                -- 檢查是否已標記為滿級
                                if isTowerMax(target) then
                                    print(string.format("[ATD 滿級] (%d/%d) %s 已達最高等級(Max)，直接跳過！", i, #recordedActions, tostring(step.towerName)))
                                    break
                                end

                                local cashBefore = getMatchCash()
                                local lvBefore = getTowerLevel(target)

                                local called, res = safeInvokeServer(upgradeFunc, 1.2, target)
                                task.wait(0.18)

                                local cashAfter = getMatchCash()
                                local lvAfter = getTowerLevel(target)

                                -- 核心成功校驗：金幣實質扣款 或 等級數值增加
                                local isSuccess = false
                                if (cashBefore > 0 and cashAfter < cashBefore) then
                                    isSuccess = true
                                elseif (lvBefore > 0 and lvAfter > lvBefore) then
                                    isSuccess = true
                                elseif (res == true or (typeof(res) == "number" and res > 0)) then
                                    isSuccess = true
                                end

                                if isSuccess then
                                    print(string.format("[ATD 升級成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                    task.wait(0.2)
                                    break
                                end

                                -- ★ 滿級防呆：如果金幣充足（大於400）卻未扣款且等級沒變，代表早就滿級了，直接跳過！
                                if cashBefore >= 400 and failedAttempts >= 2 then
                                    print(string.format("[ATD 滿級跳過] (%d/%d) 金幣充足(%d)未扣款，判定 %s 已滿級(Max)！", i, #recordedActions, cashBefore, tostring(step.towerName)))
                                    break
                                end

                                failedAttempts = failedAttempts + 1

                                -- 超過 12 秒等錢超時防卡死
                                if os.clock() - startTime > 12.0 then
                                    print(string.format("[ATD 超時] (%d/%d) 升級超時 12 秒，自動前進下一步！", i, #recordedActions))
                                    break
                                end

                                if os.clock() - lastNotifyTime >= 3.0 then
                                    lastNotifyTime = os.clock()
                                    print(string.format("[ATD 等錢升級] (%d/%d) %s 等待金幣中 (金幣: %d)...", 
                                        i, #recordedActions, tostring(step.towerName), cashBefore))
                                    if playCtrl then
                                        playCtrl.SetDesc(string.format("▶ 等錢升級 (%d/%d) 錢:%d...", i, #recordedActions, cashBefore))
                                    end
                                end

                                -- ★ 溫和防刷屏等待：失敗後至少冷卻 1.2 秒，絕不連續發包彈出紅字
                                local waitCash = getMatchCash()
                                local waitStart = os.clock()
                                while isPlaying and _G.Suite7414_NewGame_Running and UserConfig.playMacro and (os.clock() - waitStart < 1.2) do
                                    task.wait(0.2)
                                    if getMatchCash() > waitCash + 30 then break end
                                end
                            end
                            task.wait(0.2)
                        end
                    end

                -- 3. 販賣塔
                elseif step.type == "Sell" then
                    local sellFunc = (ReplicatedStorage:FindFirstChild("RemoteFunctions") and ReplicatedStorage.RemoteFunctions:FindFirstChild("SellTower"))
                        or (ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("SellTower"))

                    if sellFunc and step.position then
                        local startTime = os.clock()
                        while isPlaying and _G.Suite7414_NewGame_Running and UserConfig.playMacro do
                            if checkGameResult() then break end

                            local target = findNearestTower(step.position, 12)
                            if target then
                                safeInvokeServer(sellFunc, 1.5, target)
                                print(string.format("[ATD 賣塔成功] (%d/%d) %s (釋放塔位)", i, #recordedActions, tostring(step.towerName)))
                                task.wait(0.25)
                                break
                            else
                                if os.clock() - startTime > 1.5 then break end
                            end
                            task.wait(0.2)
                        end
                    end
                end
            end

            task.wait(0.5)
            isPlaying = false
            if playCtrl and UserConfig.playMacro then
                playCtrl.SetDesc(string.format("✓ 本局動作已執行完畢 (等待下局重開)", #recordedActions))
            end
        end)
    else
        isPlaying = false
        if playCtrl then
            playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
        end
    end
end

