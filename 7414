    switchLabel.TextSize = 10
    switchLabel.Font = Enum.Font.SourceSansBold
    switchLabel.ZIndex = 2
    switchLabel.Parent = switchBox

    local state = defaultVal
    local ctrl = {}
    function ctrl.Set(v)
        state = v
        local r, g, b = UserConfig.uiColor:match("(%d+),%s*(%d+),%s*(%d+)")
        local targetColor = (r and g and b) and Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) or Color3.fromRGB(255, 105, 180)

        if state then
            switchBox.BackgroundColor3 = targetColor
            switchLabel.TextColor3 = Color3.fromRGB(10, 25, 15)
            registerAccent(switchBox)
        else
            switchBox.BackgroundColor3 = Color3.fromRGB(35, 40, 48)
            switchLabel.TextColor3 = Color3.fromRGB(150, 155, 165)
        end
        switchLabel.Text = state and "ON" or "OFF"
    end
    function ctrl.SetDesc(newDesc)
        d.Text = newDesc
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        ctrl.Set(state)
        if callback then callback(state, ctrl) end
    end)
    return ctrl
end

