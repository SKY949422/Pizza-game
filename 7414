        switchBox.BackgroundColor3 = state and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(35, 40, 48)
        switchLabel.TextColor3 = state and Color3.fromRGB(10, 25, 15) or Color3.fromRGB(150, 155, 165)
        switchLabel.Text = state and "ON" or "OFF"
    end
    function ctrl.SetDesc(newDesc)
        d.Text = newDesc
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        ctrl.Set(state)
        if callback then callback(state, ctrl) end
    end)
    return ctrl
end

