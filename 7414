local function isGuiElementVisible(obj)
    if not obj or not obj:IsA("GuiObject") then return false end
    local cur = obj
    while cur and cur:IsA("GuiObject") do
        if not cur.Visible then return false end
        cur = cur.Parent
    end
    if cur and cur.ClassName == "ScreenGui" and not cur.Enabled then return false end
    return true
end

local function updateWaveInfo()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, obj in ipairs(playerGui:GetDescendants()) do
            if obj.ClassName == "TextLabel" and isGuiElementVisible(obj) then
                local txt = obj.Text or ""
                if txt:lower():find("wave") then
                    local c, m = txt:match("[Ww][Aa][Vv][Ee]%s*[:%-]?%s*(%d+)%s*/%s*(%d+)")
                    if not c then
                        c = txt:match("[Ww][Aa][Vv][Ee]%s*[:%-]?%s*(%d+)")
                    end

                    if c then
                        local curNum = tonumber(c)
                        local maxNum = tonumber(m) or currentMatchMaxWave
                        if curNum and (not m or curNum <= maxNum) and curNum <= 100 then
                            currentMatchWave = curNum
                            currentMatchMaxWave = maxNum
                            if currentMatchWave > highestWaveReached then
                                highestWaveReached = currentMatchWave
                            end
                            return currentMatchWave, currentMatchMaxWave
                        end
                    end
                end
            end
        end
    end

    local info = workspace:FindFirstChild("Info") or workspace:FindFirstChild("GameInfo")
    if info then
        local w = info:FindFirstChild("Wave") or info:FindFirstChild("CurrentWave")
        if w and w:IsA("ValueBase") and tonumber(w.Value) then
            local val = tonumber(w.Value)
            if val <= 100 then
                currentMatchWave = val
                if currentMatchWave > highestWaveReached then
                    highestWaveReached = currentMatchWave
                end
            end
        end
    end
    return currentMatchWave, currentMatchMaxWave
end

local function checkGameResult()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false, false end

    local isGameOver = false
    local isWin = false
    local victorySignals = 0
    local defeatSignals = 0

    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui.ClassName == "ScreenGui" and gui.Enabled then
            for _, desc in ipairs(gui:GetDescendants()) do
                if isGuiElementVisible(desc) then
                    if desc.ClassName == "TextLabel" or desc.ClassName == "TextButton" then
                        local txt = string.upper(desc.Text or "")
                        if txt:find("VICTORY") or txt:find("YOU WIN") or txt:find("勝利") or txt:find("STAGE CLEARED") or txt:find("GAME WON") then
                            victorySignals = victorySignals + 1
                            isGameOver = true
                        elseif txt:find("DEFEAT") or txt:find("GAME OVER") or txt:find("失敗") or txt:find("YOU LOSE") or txt:find("FAILED") then
                            defeatSignals = defeatSignals + 1
                            isGameOver = true
                        elseif desc.Name == "ReplayVote" or txt:find("REPLAY") or txt:find("VOTE") or txt:find("重玩") or txt:find("RETRY") then
                            isGameOver = true
                        end
                    end
                end
            end
        end
    end

    if isGameOver then
        if currentMatchMaxWave > 0 and highestWaveReached < currentMatchMaxWave then
            isWin = false
        elseif defeatSignals > 0 and defeatSignals > victorySignals then
            isWin = false
        elseif currentMatchMaxWave > 0 and highestWaveReached >= currentMatchMaxWave and defeatSignals == 0 then
            isWin = true
        elseif victorySignals > 0 and victorySignals >= defeatSignals then
            isWin = true
        else
            isWin = false
        end
    end

    return isGameOver, isWin
end

