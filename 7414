local function safeGetPosition(inst)
    if not inst or typeof(inst) ~= "Instance" then return nil end
    local pos = nil
    pcall(function()
        if inst.ClassName == "Model" then
            local root = inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart")
            if root then
                pos = root.Position
            else
                pos = inst:GetPivot().Position
            end
        elseif inst:IsA("BasePart") then
            pos = inst.Position
        end
    end)
    if pos and pos.Magnitude < 1.0 then pos = nil end
    return pos
end

