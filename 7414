local function serializeActions(actions)
    local serialized = {}
    for _, step in ipairs(actions) do
        local item = { type = step.type, delay = step.delay }
        if step.type == "Place" then
            item.towerName = step.towerName
            item.cframe = {step.cframe:GetComponents()}
            item.remoteName = step.remoteName
            item.isEvent = step.isEvent
        elseif step.type == "Upgrade" or step.type == "Sell" then
            item.position = step.position and {step.position.X, step.position.Y, step.position.Z} or nil
            item.towerName = step.towerName
        end
        table.insert(serialized, item)
    end
    return serialized
end

local function deserializeActions(data)
    local actions = {}
    for _, item in ipairs(data) do
        if item.type == "Place" and item.cframe then
            table.insert(actions, {
                type = "Place",
                delay = item.delay or 0,
                towerName = item.towerName,
                cframe = CFrame.new(unpack(item.cframe)),
                remoteName = item.remoteName or "PlaceTower",
                isEvent = item.isEvent or false
            })
        elseif (item.type == "Upgrade" or item.type == "Sell") and item.position then
            table.insert(actions, {
                type = item.type,
                delay = item.delay or 0,
                position = Vector3.new(unpack(item.position)),
                towerName = item.towerName
            })
        end
    end
    return actions
end

