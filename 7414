-- 2. 座標與波次輔助函式
-- --------------------------------------------------------
local function getInstancePosition(inst)
    if not inst or typeof(inst) ~= "Instance" then return nil end
    local pos = nil
    pcall(function()
        if inst:IsA("Model") then
            pos = inst:GetPivot().Position
        elseif inst:IsA("BasePart") then
            pos = inst.Position
        end
    end)
    return pos
end

local function findNearestTower(targetPos, maxDist)
    local bestTower = nil
    local minDistance = maxDist or 6
    local towersFolder = workspace:FindFirstChild("Towers")

    if towersFolder and targetPos then
        for _, child in ipairs(towersFolder:GetChildren()) do
            local pos = getInstancePosition(child)
            if pos then
                local dist = (pos - targetPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    bestTower = child
                end
            end
        end
    end
    return bestTower
end

local function getCurrentWave()
    local info = workspace:FindFirstChild("Info") or workspace:FindFirstChild("GameInfo")
    if info then
        local w = info:FindFirstChild("Wave") or info:FindFirstChild("CurrentWave")
        if w and w:IsA("ValueBase") and tonumber(w.Value) then
            return tonumber(w.Value)
        end
    end
    if workspace:FindFirstChild("Wave") and workspace.Wave:IsA("ValueBase") then
        return tonumber(workspace.Wave.Value)
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, obj in ipairs(playerGui:GetDescendants()) do
            if obj:IsA("TextLabel") and obj.Visible then
                local wMatch = obj.Text:match("[Ww]ave%s*(%d+)%s*/") or obj.Text:match("[Ww]ave%s*[:%-]?%s*(%d+)")
                if wMatch then
                    return tonumber(wMatch)
                end
            end
        end
    end
    return nil
end

local function serializeActions(actions)
    local serialized = {}
    for _, step in ipairs(actions) do
        local item = { type = step.type, delay = step.delay }
        if step.type == "Place" then
            item.towerName = step.towerName
            item.cframe = {step.cframe:GetComponents()}
        elseif step.type == "Upgrade" or step.type == "Sell" then
            item.position = step.position and {step.position.X, step.position.Y, step.position.Z} or nil
            item.towerName = step.towerName
        end
        table.insert(serialized, item)
    end
    return serialized
end

local function deserializeActions(data)
    local actions = {}
    for _, item in ipairs(data) do
        if item.type == "Place" and item.cframe then
            table.insert(actions, {
                type = "Place",
                delay = item.delay or 0,
                towerName = item.towerName,
                cframe = CFrame.new(unpack(item.cframe))
            })
        elseif (item.type == "Upgrade" or item.type == "Sell") and item.position then
            table.insert(actions, {
                type = item.type,
                delay = item.delay or 0,
                position = Vector3.new(unpack(item.position)),
                towerName = item.towerName
            })
        end
    end
    return actions
end

local updateMacroListView

local function refreshMacroList()
    macroList = {}
    if listfiles then
        local files = listfiles(FOLDER_NAME)
        for _, filePath in ipairs(files) do
            local fileName = filePath:match("([^/\\]+)%.json$")
            if fileName and fileName ~= "config" then
                table.insert(macroList, fileName)
            end
        end
    end
    if #macroList == 0 then table.insert(macroList, "Default") end
end

local function saveCurrentMacro()
    if not writefile then return end
    ensureDirectory()
    local path = FOLDER_NAME .. "/" .. currentMacroName .. ".json"
    local serialized = serializeActions(recordedActions)
    pcall(function()
        writefile(path, HttpService:JSONEncode(serialized))
    end)
    UserConfig.currentMacro = currentMacroName
    saveUserConfig()
end

local function loadMacro(name)
    currentMacroName = name
    UserConfig.currentMacro = name
    saveUserConfig()
    local path = FOLDER_NAME .. "/" .. name .. ".json"
    recordedActions = {}
    if isfile and isfile(path) then
        local ok, content = pcall(function() return readfile(path) end)
        if ok and content then
            local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeOk and typeof(data) == "table" then
                recordedActions = deserializeActions(data)
                print(string.format("[ATD Macro] 已載入「%s」(共 %d 步)", name, #recordedActions))
            end
        end
    end
end

local function deleteCurrentMacro()
    local path = FOLDER_NAME .. "/" .. currentMacroName .. ".json"
    if isfile and isfile(path) and delfile then
        pcall(function() delfile(path) end)
    end
    recordedActions = {}
    refreshMacroList()
    currentMacroName = macroList[1] or "Default"
    loadMacro(currentMacroName)
    if updateMacroListView then updateMacroListView() end
end

