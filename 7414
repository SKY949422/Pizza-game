end)

playCtrl = createSwitch(pageMacro, "執行重播 (Play Macro)", "持久開啟，每局進圖秒放", UserConfig.playMacro, function(st)
    UserConfig.playMacro = st
    saveUserConfig()
    if st then
        hasPlayedThisMatch = false
        runPlayMacro(true)
    else
        isPlaying = false
        runPlayMacro(false)
    end
end, 2)

recordCtrl = createSwitch(pageMacro, "錄製操作 (Record Macro)", "開啟後放塔、升級與賣塔", false, function(st, ctrl)
    if isPlaying then
        ctrl.Set(false)
        return
    end
    isRecording = st
    if isRecording then
        recordedActions = {}
        lastActionTime = os.clock()
        print(string.format("[ATD] 開始錄製至「%s」", currentMacroName))
    else
        saveCurrentMacro()
        print(string.format("[ATD] 結束錄製，已存 %d 步動作", #recordedActions))
    end
end, 3)

task.spawn(function()
    local lastCount = -1
    local lastState = false
    while _G.Suite7414_NewGame_Running do
        task.wait(0.2)
        if #recordedActions ~= lastCount or isRecording ~= lastState then
            lastCount = #recordedActions
            lastState = isRecording
            pcall(function()
                if recordCtrl then
                    recordCtrl.SetDesc(isRecording and string.format("● 錄製中... (已捕捉 %d 步動作)", #recordedActions) or "開啟後放塔、升級與賣塔")
                end
                if playCtrl and not isPlaying and not UserConfig.playMacro then
                    playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
                end
            end)
        end
    end
end)

