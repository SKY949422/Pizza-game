-- 1. 檔案與持久化配置管理
-- --------------------------------------------------------
local function ensureDirectory()
    if isfolder and makefolder then
        if not isfolder(FOLDER_NAME) then
            pcall(function() makefolder(FOLDER_NAME) end)
        end
    end
end
ensureDirectory()

local function saveUserConfig()
    if not writefile then return end
    ensureDirectory()
    pcall(function()
        writefile(CONFIG_FILE_PATH, HttpService:JSONEncode(UserConfig))
    end)
end

local function loadUserConfig()
    if isfile and isfile(CONFIG_FILE_PATH) then
        local ok, content = pcall(function() return readfile(CONFIG_FILE_PATH) end)
        if ok and content then
            local decodeOk, data = pcall(function() return HttpService:JSONDecode(content) end)
            if decodeOk and typeof(data) == "table" then
                for k, v in pairs(data) do 
                    UserConfig[k] = v 
                end
                currentMacroName = UserConfig.currentMacro or "Default"
            end
        end
    end
end
