applyCustomTheme = function()
    local r, g, b = UserConfig.uiColor:match("(%d+),%s*(%d+),%s*(%d+)")
    local targetColor = (r and g and b) and Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) or Color3.fromRGB(255, 105, 180)

    brandBadge.BackgroundColor3 = targetColor
    for _, el in ipairs(accentElements) do
        if el and el.Parent then
            if el:IsA("UIStroke") then
                el.Color = targetColor
            elseif el:IsA("TextButton") then
                el.TextColor3 = targetColor
            else
                el.BackgroundColor3 = targetColor
            end
        end
    end

    if UserConfig.bgImageId and UserConfig.bgImageId ~= "" then
        local idNum = UserConfig.bgImageId:match("%d+")
        bgImageLabel.Image = idNum and ("rbxassetid://" .. idNum) or UserConfig.bgImageId
