updateMacroListView = function()
    refreshMacroList()
    for _, ch in ipairs(macroScroll:GetChildren()) do
        if ch.ClassName == "TextButton" then ch:Destroy() end
    end
    for _, name in ipairs(macroList) do
        local isCur = (name == currentMacroName)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 110, 0, 30)
        btn.BackgroundColor3 = isCur and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(24, 28, 35)
        btn.Text = name
        btn.TextColor3 = isCur and Color3.fromRGB(10, 25, 15) or Color3.fromRGB(180, 185, 195)
        btn.TextSize = 11
        btn.Font = Enum.Font.SourceSansBold
        btn.ZIndex = 2
        btn.Parent = macroScroll
        if isCur then registerAccent(btn) end
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            loadMacro(name)
            updateMacroListView()
        end)
    end
    macroScroll.CanvasSize = UDim2.new(0, #macroList * 116, 0, 0)
end

