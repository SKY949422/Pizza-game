local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if isRecording and not isPlaying and not checkcaller() then
        if method == "InvokeServer" or method == "invokeServer" then
            if self and self.Name == "PlaceTower" then
                local now = os.clock()
                local delay = (#recordedActions == 0) and 0 or (now - lastActionTime)
                lastActionTime = now

                table.insert(recordedActions, {
                    type = "Place",
                    delay = delay,
                    towerName = args[1],
                    cframe = args[2]
                })
                print(string.format("[ATD 捕捉] 放塔: %s (步數: %d)", tostring(args[1]), #recordedActions))

            elseif self and self.Name == "UpgradeTower" then
                local now = os.clock()
                local delay = (#recordedActions == 0) and 0 or (now - lastActionTime)
                lastActionTime = now

                local inst = args[1]
                local pos = getInstancePosition(inst)

                table.insert(recordedActions, {
                    type = "Upgrade",
                    delay = delay,
                    position = pos,
                    towerName = inst and inst.Name or "Tower"
                })
                print(string.format("[ATD 捕捉] 升級: %s (步數: %d)", tostring(inst and inst.Name), #recordedActions))

            elseif self and self.Name == "SellTower" then
                local now = os.clock()
                local delay = (#recordedActions == 0) and 0 or (now - lastActionTime)
                lastActionTime = now

                local inst = args[1]
                local pos = getInstancePosition(inst)

                table.insert(recordedActions, {
                    type = "Sell",
                    delay = delay,
                    position = pos,
                    towerName = inst and inst.Name or "Tower"
                })
                print(string.format("[ATD 捕捉] 販賣: %s (步數: %d)", tostring(inst and inst.Name), #recordedActions))
            end
        end
    end

    setnamecallmethod(method)
    return oldNamecall(self, ...)
end))

