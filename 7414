-- 4. 自動守護線程 (進圖自動重播 + 跳波 + 重開)
-- --------------------------------------------------------
task.spawn(function()
    task.wait(1.5)
    local hasTriggeredReplay = false
    local hasAutoPlayedThisMatch = false
    local lastVotedNextWave = -1
    local lastVoteTime = 0

    while _G.Suite7414_NewGame_Running do
        task.wait(0.5)

        local currentWave = getCurrentWave()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local isGameOver = false

        if playerGui then
            for _, gui in ipairs(playerGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled then
                    local endFrame = gui:FindFirstChild("EndScreen", true) 
                        or gui:FindFirstChild("Victory", true) 
                        or gui:FindFirstChild("GameOver", true)
                        or gui:FindFirstChild("Replay", true)
                        or gui:FindFirstChild("ReplayVote", true)

                    if endFrame and (endFrame:IsA("GuiObject") and endFrame.Visible) then
                        isGameOver = true
                        break
                    end
                end
            end
        end

        -- 1. 進圖 / 開局自動重播 (Auto Play Macro)
        if currentWave and currentWave >= 1 and not isGameOver then
            if not hasAutoPlayedThisMatch then
                hasAutoPlayedThisMatch = true
                hasTriggeredReplay = false

                if UserConfig.autoPlayMacro and #recordedActions > 0 and not isPlaying and not isRecording then
                    task.spawn(function()
                        task.wait(2.5) -- 等候場景與金幣就緒
                        if not _G.Suite7414_NewGame_Running or isPlaying or isRecording then return end
                        print(string.format("[Auto Play] 偵測到開局，自動啟動 Macro「%s」", currentMacroName))
                        if runPlayMacro then runPlayMacro(true) end
                    end)
                end
            end
        elseif isGameOver or (currentWave and currentWave == 0) then
            hasAutoPlayedThisMatch = false
        end

        -- 2. 自動跳波 (Auto Skip: 傳送 NextWave = currentWave + 1)
        if UserConfig.autoSkip and not isGameOver then
            if currentWave then
                local targetNextWave = currentWave + 1
                local now = os.clock()

                if targetNextWave ~= lastVotedNextWave or (now - lastVoteTime > 1.2) then
                    lastVoteTime = now
                    lastVotedNextWave = targetNextWave

                    pcall(function()
                        local skipEvent = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("SkipWaveVote")
                        if skipEvent then
                            skipEvent:FireServer(targetNextWave)
                        end
                    end)

                    if playerGui then
                        for _, obj in ipairs(playerGui:GetDescendants()) do
                            if obj:IsA("GuiButton") or obj:IsA("TextLabel") then
                                if obj.Text and obj.Text:find("自動跳過") then
                                    local btn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton")
                                    if btn and btn.Visible then
                                        pcall(function()
                                            if firesignal then
                                                firesignal(btn.Activated)
                                                firesignal(btn.MouseButton1Click)
                                            end
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        -- 3. 自動重開 (Auto Replay)
        if UserConfig.autoReplay then
            if isGameOver and not hasTriggeredReplay then
                hasTriggeredReplay = true
                print("[Auto Replay] 偵測到結算畫面，發送 ReplayVote 投票重開！")

                task.spawn(function()
                    for attempt = 1, 6 do
                        if not _G.Suite7414_NewGame_Running then break end

                        pcall(function()
                            local replayEvent = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("ReplayVote")
                            if replayEvent then
                                replayEvent:FireServer()
                            end
                        end)

                        task.wait(0.8)
                    end
                end)
            elseif not isGameOver then
                hasTriggeredReplay = false
            end
        end
    end
end)

-- --------------------------------------------------------
-- 5. 巨集重播核心 (等錢秒放 + 等錢秒升 + 精準賣塔)
-- --------------------------------------------------------
runPlayMacro = function(st)
    if isRecording then
        if playCtrl then playCtrl.Set(false) end
        return
    end

    if st then
        if #recordedActions == 0 then
            warn("[ATD 提示] 目前檔案無動作記錄，請先開啟錄製。")
            if playCtrl then playCtrl.Set(false) end
            return
        end

        task.spawn(function()
            isPlaying = true
            if playCtrl then playCtrl.Set(true) end
            print(string.format("[ATD 重播開始] 執行「%s」，共 %d 步 (等錢秒升模式)", currentMacroName, #recordedActions))

            for i, step in ipairs(recordedActions) do
                if not isPlaying or not _G.Suite7414_NewGame_Running then break end
                if playCtrl then
                    playCtrl.SetDesc(string.format("▶ 執行中 (%d/%d 步)...", i, #recordedActions))
                end

                if step.delay > 0 then
                    local targetWait = UserConfig.smartFastMode and math.clamp(step.delay * 0.1, 0.15, 1.0) or (step.delay * UserConfig.macroScale)
                    local waited = 0
                    while waited < targetWait and isPlaying and _G.Suite7414_NewGame_Running do
                        task.wait(0.05)
                        waited = waited + 0.05
                    end
                end

                if not isPlaying or not _G.Suite7414_NewGame_Running then break end

                local rfFolder = ReplicatedStorage:FindFirstChild("RemoteFunctions")
                if not rfFolder then break end

                -- 1. 放塔
                if step.type == "Place" then
                    local placeFunc = rfFolder:FindFirstChild("PlaceTower")
                    if placeFunc then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local res = nil
                            pcall(function()
                                res = placeFunc:InvokeServer(step.towerName, step.cframe)
                            end)

                            local spawnedTower = findNearestTower(step.cframe.Position, 5)
                            if (res ~= false and res ~= nil) or spawnedTower then
                                print(string.format("[ATD 放塔成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                task.wait(0.3)
                                break
                            end
                            task.wait(0.25)
                        end
                    end

                -- 2. 升級 (等錢秒升)
                elseif step.type == "Upgrade" then
                    local upgradeFunc = rfFolder:FindFirstChild("UpgradeTower")
                    if upgradeFunc and step.position then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local target = findNearestTower(step.position, 6)
                            if target then
                                local res = nil
                                pcall(function()
                                    res = upgradeFunc:InvokeServer(target)
                                end)

                                if res ~= false and res ~= nil then
                                    print(string.format("[ATD 升級成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                    task.wait(0.3)
                                    break
                                end
                            end
                            task.wait(0.25)
                        end
                    end

                -- 3. 販賣
                elseif step.type == "Sell" then
                    local sellFunc = rfFolder:FindFirstChild("SellTower")
                    if sellFunc and step.position then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local target = findNearestTower(step.position, 6)
                            if target then
                                pcall(function() sellFunc:InvokeServer(target) end)
                                print(string.format("[ATD 賣塔成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                task.wait(0.25)
                                break
                            else
                                break
                            end
                        end
                    end
                end
            end

            task.wait(0.5)
            isPlaying = false
            if playCtrl then
                playCtrl.Set(false)
                playCtrl.SetDesc(string.format("✓ 重播已完成 (共 %d 步)", #recordedActions))
            end
        end)
    else
        isPlaying = false
        if playCtrl then
            playCtrl.Set(false)
            playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
        end
    end
end

