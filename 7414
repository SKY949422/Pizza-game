local function safeInvokeServer(remoteFunc, timeout, ...)
    local done = false
    local result = nil
    local args = {...}

    task.spawn(function()
        pcall(function()
            if remoteFunc.ClassName == "RemoteFunction" then
                result = remoteFunc:InvokeServer(unpack(args))
            else
                remoteFunc:FireServer(unpack(args))
                result = true
            end
        end)
        done = true
    end)

    local startWait = os.clock()
    local maxWait = timeout or 1.5
    while not done and (os.clock() - startWait < maxWait) do
        task.wait(0.06)
    end

    return done, result
end

