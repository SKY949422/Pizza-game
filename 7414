-- 9. 自動守護線程 (開局秒放 + 自動跳波 + 重開)
-- --------------------------------------------------------
task.spawn(function()
    task.wait(1.0)
    local hasTriggeredReplay = false
    local lastVotedNextWave = -1
    local lastVoteTime = 0
    snapshotCurrencies()

    while _G.Suite7414_NewGame_Running do
        task.wait(0.4)

        local curW, maxW = updateWaveInfo()
        local isGameOver, isWin = checkGameResult()

        -- 1. 開局秒執行
        if not isGameOver then
            if UserConfig.playMacro and not isPlaying and not isRecording and not hasPlayedThisMatch and #recordedActions > 0 then
                hasPlayedThisMatch = true
                hasTriggeredReplay = false
                highestWaveReached = curW or 1
                matchStartTime = os.time()
                snapshotCurrencies()
                print(string.format("[Auto Loop] 進入遊戲，立刻啟動 Macro「%s」！", currentMacroName))
                runPlayMacro(true)
            end
        else
            hasPlayedThisMatch = false
        end

        -- 2. 自動跳波 (次輪投票 curW + 1)
        if UserConfig.autoSkip and not isGameOver and curW and curW >= 1 then
            local targetNextWave = curW + 1
            local now = os.clock()

            if targetNextWave ~= lastVotedNextWave or (now - lastVoteTime > 1.2) then
                lastVoteTime = now
                lastVotedNextWave = targetNextWave

                pcall(function()
                    local skipEvent = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("SkipWaveVote")
                    if skipEvent then skipEvent:FireServer(targetNextWave) end
                end)

                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, obj in ipairs(playerGui:GetDescendants()) do
                        if obj.ClassName == "GuiButton" or obj.ClassName == "TextLabel" then
                            if obj.Text and obj.Text:find("自動跳過") then
                                local btn = (obj.ClassName == "GuiButton" and obj) or obj:FindFirstAncestorWhichIsA("GuiButton")
                                if btn and isGuiElementVisible(btn) then
                                    pcall(function()
                                        if firesignal then
                                            firesignal(btn.Activated)
                                            firesignal(btn.MouseButton1Click)
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end
            end
        end

        -- 3. 結算推播與自動重開
        if isGameOver and not hasTriggeredReplay then
            hasTriggeredReplay = true
            _G.Suite7414_MatchesPlayed = _G.Suite7414_MatchesPlayed + 1
            if isWin then 
                _G.Suite7414_Wins = _G.Suite7414_Wins + 1 
            else 
                _G.Suite7414_Losses = _G.Suite7414_Losses + 1 
            end

            local finalWave = math.min(highestWaveReached, currentMatchMaxWave)
            print(string.format("[ATD 結算] 結果: %s (波次: %d/%d)，推送 Webhook！", isWin and "勝利" or "失敗", finalWave, currentMatchMaxWave))
            sendDiscordWebhook(isWin, finalWave, false)

            if UserConfig.autoReplay then
                task.spawn(function()
                    for attempt = 1, 6 do
                        if not _G.Suite7414_NewGame_Running then break end
                        pcall(function()
                            local replayEvent = ReplicatedStorage:FindFirstChild("RemoteEvents") and ReplicatedStorage.RemoteEvents:FindFirstChild("ReplayVote")
                            if replayEvent then replayEvent:FireServer() end
                        end)
                        task.wait(0.8)
                    end
                end)
            end
        elseif not isGameOver then
            hasTriggeredReplay = false
        end
    end
end)

