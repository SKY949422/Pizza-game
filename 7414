-- 6. 巨集重播核心 (流暢原生節奏 + 等錢秒放 + 等錢秒升)
-- --------------------------------------------------------
runPlayMacro = function(st)
    if isRecording then
        if playCtrl then playCtrl.Set(false) end
        return
    end

    if st then
        if #recordedActions == 0 then
            warn("[ATD 提示] 目前檔案無動作記錄，請先開啟錄製。")
            if playCtrl then playCtrl.Set(false) end
            return
        end

        task.spawn(function()
            isPlaying = true
            if playCtrl then playCtrl.Set(true) end
            print(string.format("[ATD 重播開始] 執行「%s」，共 %d 步 (等錢秒升模式)", currentMacroName, #recordedActions))

            for i, step in ipairs(recordedActions) do
                if not isPlaying or not _G.Suite7414_NewGame_Running then break end
                if playCtrl then
                    playCtrl.SetDesc(string.format("▶ 執行中 (%d/%d 步)...", i, #recordedActions))
                end

                if step.delay > 0 then
                    local targetWait = step.delay * (UserConfig.macroScale or 1.0)
                    local waited = 0
                    while waited < targetWait and isPlaying and _G.Suite7414_NewGame_Running do
                        task.wait(0.05)
                        waited = waited + 0.05
                    end
                end

                if not isPlaying or not _G.Suite7414_NewGame_Running then break end

                local rfFolder = ReplicatedStorage:FindFirstChild("RemoteFunctions")
                if not rfFolder then break end

                -- 1. 放塔
                if step.type == "Place" then
                    local placeFunc = rfFolder:FindFirstChild("PlaceTower")
                    if placeFunc then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local res = nil
                            pcall(function()
                                res = placeFunc:InvokeServer(step.towerName, step.cframe)
                            end)

                            local spawnedTower = findNearestTower(step.cframe.Position, 5)
                            if (res ~= false and res ~= nil) or spawnedTower then
                                print(string.format("[ATD 放塔成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                task.wait(0.3)
                                break
                            end
                            task.wait(0.25)
                        end
                    end

                -- 2. 升級 (等錢秒升)
                elseif step.type == "Upgrade" then
                    local upgradeFunc = rfFolder:FindFirstChild("UpgradeTower")
                    if upgradeFunc and step.position then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local target = findNearestTower(step.position, 6)
                            if target then
                                local res = nil
                                pcall(function()
                                    res = upgradeFunc:InvokeServer(target)
                                end)

                                if res ~= false and res ~= nil then
                                    print(string.format("[ATD 升級成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                    task.wait(0.3)
                                    break
                                end
                            end
                            task.wait(0.25)
                        end
                    end

                -- 3. 販賣
                elseif step.type == "Sell" then
                    local sellFunc = rfFolder:FindFirstChild("SellTower")
                    if sellFunc and step.position then
                        while isPlaying and _G.Suite7414_NewGame_Running do
                            local target = findNearestTower(step.position, 6)
                            if target then
                                pcall(function() sellFunc:InvokeServer(target) end)
                                print(string.format("[ATD 賣塔成功] (%d/%d) %s", i, #recordedActions, tostring(step.towerName)))
                                task.wait(0.25)
                                break
                            else
                                break
                            end
                        end
                    end
                end
            end

            task.wait(0.5)
            isPlaying = false
            if playCtrl then
                playCtrl.Set(false)
                playCtrl.SetDesc(string.format("✓ 重播已完成 (共 %d 步)", #recordedActions))
            end
        end)
    else
        isPlaying = false
        if playCtrl then
            playCtrl.Set(false)
            playCtrl.SetDesc(string.format("檔案: %s (共 %d 步動作)", currentMacroName, #recordedActions))
        end
    end
end

