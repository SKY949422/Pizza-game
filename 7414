local blacklistedKeys = {
    ["cash"] = true, ["money"] = true, ["dollar"] = true, ["dollars"] = true,
    ["matchcash"] = true, ["hp"] = true, ["health"] = true, ["basehealth"] = true,
    ["wave"] = true, ["waves"] = true, ["win"] = true, ["wins"] = true,
    ["loss"] = true, ["losses"] = true
}

local function isBlacklisted(name)
    local lower = string.lower(name)
    for k in pairs(blacklistedKeys) do
        if lower:find(k) then return true end
    end
    return false
end

local function snapshotCurrencies()
    initialCurrencies = {}
    local function recordVal(name, val)
        if not isBlacklisted(name) then
            if initialCurrencies[name] == nil then initialCurrencies[name] = val end
        end
    end

    local function scan(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("ValueBase") then recordVal(child.Name, child.Value) end
        end
    end

    scan(LocalPlayer:FindFirstChild("leaderstats"))
    scan(LocalPlayer:FindFirstChild("Currencies"))
    scan(LocalPlayer:FindFirstChild("Data"))
end

local function scanEndScreenRewards()
    local rewards = {}
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return rewards end

    for _, gui in ipairs(playerGui:GetChildren()) do
        if gui.ClassName == "ScreenGui" and gui.Enabled then
            for _, desc in ipairs(gui:GetDescendants()) do
                if desc.ClassName == "TextLabel" and isGuiElementVisible(desc) then
                    local txt = desc.Text or ""
                    local num, curName = txt:match("%+?(%d+[,%d]*)%s*([Cc]oins?)")
                    if not num then num, curName = txt:match("%+?(%d+[,%d]*)%s*([Gg]ems?)") end
                    if not num then num, curName = txt:match("%+?(%d+[,%d]*)%s*([Ee][Xx][Pp])") end
                    if not num then num, curName = txt:match("%+?(%d+[,%d]*)%s*([Tt]okens?)") end

                    if num and curName and not isBlacklisted(curName) then
                        table.insert(rewards, string.format("• %s: +%s", curName, num))
                    end
                end
            end
        end
    end
    return rewards
end

local function sendDiscordWebhook(isVictory, wavesBeaten, isTest)
    if not UserConfig.notifyStageFinished or UserConfig.webhookUrl:gsub("%s+", "") == "" then return end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not httpRequest then return end

    local matchDuration = os.time() - matchStartTime
    local sessionDuration = os.time() - _G.Suite7414_SessionStart
    local mapName = (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChildOfClass("Model") and workspace.Map:FindFirstChildOfClass("Model").Name) or "ATD Arena"

    local rewardsList = {}
    local isRareDrop = false
    local processedKeys = {}

    local function scanForDeltas(container)
        if not container then return end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("ValueBase") and typeof(child.Value) == "number" and not isBlacklisted(child.Name) then
                local init = initialCurrencies[child.Name] or child.Value
                local delta = child.Value - init
                if delta > 0 and not processedKeys[child.Name] then
                    processedKeys[child.Name] = true
                    table.insert(rewardsList, string.format("• %s: +%s (%s)", child.Name, tostring(delta), tostring(child.Value)))
                    if child.Name:lower():find("gem") or child.Name:lower():find("token") or child.Name:lower():find("crate") then
                        isRareDrop = true
                    end
                end
            end
        end
    end

    scanForDeltas(LocalPlayer:FindFirstChild("leaderstats"))
    scanForDeltas(LocalPlayer:FindFirstChild("Currencies"))
    scanForDeltas(LocalPlayer:FindFirstChild("Data"))

    local guiRewards = scanEndScreenRewards()
    for _, r in ipairs(guiRewards) do
        table.insert(rewardsList, r)
    end

    if isTest and #rewardsList == 0 then
        table.insert(rewardsList, "• Coins: +500 (1500)")
        table.insert(rewardsList, "• Gems: +50 (120)")
    end

    local rewardsText = #rewardsList > 0 and table.concat(rewardsList, "\n") or "• 通關獎勵結算中"
    local playerName = UserConfig.webhookHideName and ("||" .. LocalPlayer.Name .. "||") or LocalPlayer.Name

    local displayWave = math.min(wavesBeaten or highestWaveReached, currentMatchMaxWave)
    local waveDisplay = string.format("Wave %d / %d %s", 
        displayWave, 
        currentMatchMaxWave, 
        isVictory and "(通關)" or "(失敗)"
    )

    local fieldsList = {
        { name = "玩家", value = playerName, inline = true },
        { name = "波次進度", value = waveDisplay, inline = true },
        { name = "戰鬥狀態", value = string.format("結果: %s\n地圖: %s\n耗時: %s", isVictory and "勝利 (Victory)" or "失敗 (Defeat)", mapName, formatTime(matchDuration)), inline = false },
        { name = "獲得獎勵", value = rewardsText, inline = false }
    }

    if UserConfig.notifySessionData then
        table.insert(fieldsList, {
            name = "Session 統計",
            value = string.format("累計時間: %s\n累計場次: %d (勝/負: %d/%d)", formatSessionTime(sessionDuration), _G.Suite7414_MatchesPlayed, _G.Suite7414_Wins, _G.Suite7414_Losses),
            inline = false
        })
    end

    local mentionContent = ""
    if UserConfig.mentionId:gsub("%s+", "") ~= "" then
        local rawId = UserConfig.mentionId:gsub("[^%d]", "")
        if rawId ~= "" and (not UserConfig.onlyMentionRare or isRareDrop) then
            mentionContent = "<@" .. rawId .. ">"
        end
    end

    local embed = {
        title = "Alliance Tower Defense 戰報",
        color = isVictory and 16738740 or 15158332,
        fields = fieldsList,
        footer = { text = "7414 TD Suite • " .. os.date("%Y/%m/%d %X") }
    }

    pcall(function()
        httpRequest({
            Url = UserConfig.webhookUrl,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                content = mentionContent ~= "" and mentionContent or nil,
                username = "7414 ATD Notifier",
                avatar_url = "https://i.imgur.com/8QpZ5n7.png",
                embeds = {embed}
            })
        })
    end)
end

